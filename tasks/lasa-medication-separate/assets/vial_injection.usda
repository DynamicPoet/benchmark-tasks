    def Scope "Looks"
    {
        def Material "cap"
        {
            token outputs:surface.connect = </vial/Looks/cap/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.95, 0.42, 0.08)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }
        def Material "crimp"
        {
            token outputs:surface.connect = </vial/Looks/crimp/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.9
                color3f inputs:diffuseColor = (0.72, 0.72, 0.74)
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
        def Material "glass"
        {
            token outputs:surface.connect = </vial/Looks/glass/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.8, 0.84, 0.86)
                float inputs:roughness = 0.08
                token outputs:surface
            }
        }
        def Material "tex_label"
        {
            token outputs:surface.connect = </vial/Looks/tex_label/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor.connect = </vial/Looks/tex_label/color_tex.outputs:rgb>
                float inputs:roughness = 0.5
                token outputs:surface
            }
            def Shader "uv"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "color_tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/label_injection.png@
                float2 inputs:st.connect = </vial/Looks/tex_label/uv.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                token inputs:sourceColorSpace = "sRGB"
                float4 inputs:scale = (1.0, 1.0, 1.0, 1)
                float3 outputs:rgb
            }
        }
    }

