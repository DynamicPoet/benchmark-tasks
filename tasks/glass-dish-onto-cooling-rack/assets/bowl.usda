    def Scope "Looks"
    {
        def Material "pan"
        {
            token outputs:surface.connect = </bowl/Looks/pan/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.92, 0.92, 0.9)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }
        def Material "water"
        {
            token outputs:surface.connect = </bowl/Looks/water/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.45, 0.62, 0.75)
                float inputs:roughness = 0.02
                float inputs:opacity = 0.55
                token outputs:surface
            }
        }
    }

