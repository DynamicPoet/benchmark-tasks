#usda 1.0
(
    defaultPrim = "plate"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "plate" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    float physics:mass = 1.0000
    int physxRigidBody:solverPositionIterationCount = 32
    int physxRigidBody:solverVelocityIterationCount = 4
    float physxRigidBody:maxDepenetrationVelocity = 1

    def Material "PhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:staticFriction = 0.5000
        float physics:dynamicFriction = 0.4500
        float physics:restitution = 0
    }

    def Cube "c_plate" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </plate/PhysicsMaterial>
        uniform token purpose = "guide"
        double size = 1
        float physxCollision:contactOffset = 0.004
        float physxCollision:restOffset = 0
        double3 xformOp:translate = (0.000000, 0.000000, 0.030000)
        float3 xformOp:scale = (0.280000, 0.290000, 0.060000)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "c_trivet" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </plate/PhysicsMaterial>
        uniform token purpose = "guide"
        double size = 1
        float physxCollision:contactOffset = 0.004
        float physxCollision:restOffset = 0
        double3 xformOp:translate = (0.000000, 0.000000, 0.065800)
        float3 xformOp:scale = (0.134350, 0.134350, 0.010000)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Scope "Looks"
    {
        def Material "cork"
        {
            token outputs:surface.connect = </plate/Looks/cork/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.62, 0.45, 0.28)
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
        def Material "iron"
        {
            token outputs:surface.connect = </plate/Looks/iron/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.4
                color3f inputs:diffuseColor = (0.05, 0.05, 0.05)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
        def Material "knob"
        {
            token outputs:surface.connect = </plate/Looks/knob/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.02, 0.02, 0.02)
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }
        def Material "steel"
        {
            token outputs:surface.connect = </plate/Looks/steel/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.9
                color3f inputs:diffuseColor = (0.75, 0.76, 0.78)
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
    }

