#usda 1.0
(
    defaultPrim = "mitt"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "mitt" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    float physics:mass = 1.0000
    int physxRigidBody:solverPositionIterationCount = 32
    int physxRigidBody:solverVelocityIterationCount = 4
    float physxRigidBody:maxDepenetrationVelocity = 1

    def Material "PhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:staticFriction = 0.6000
        float physics:dynamicFriction = 0.5000
        float physics:restitution = 0
    }

    def Cube "c_mitt" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </mitt/PhysicsMaterial>
        uniform token purpose = "guide"
        double size = 1
        float physxCollision:contactOffset = 0.004
        float physxCollision:restOffset = 0
        double3 xformOp:translate = (0.000000, 0.000000, 0.007500)
        float3 xformOp:scale = (0.270000, 0.136000, 0.015000)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Scope "Looks"
    {
        def Material "mitt"
        {
            token outputs:surface.connect = </mitt/Looks/mitt/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.7, 0.08, 0.06)
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }
        def Material "mitt_cuff"
        {
            token outputs:surface.connect = </mitt/Looks/mitt_cuff/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.92, 0.9, 0.86)
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }
    }

