    def Scope "Looks"
    {
        def Material "glass"
        {
            token outputs:surface.connect = </flask/Looks/glass/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.9, 0.96, 0.98)
                float inputs:roughness = 0.02
                float inputs:opacity = 0.12
                token outputs:surface
            }
        }
    }

