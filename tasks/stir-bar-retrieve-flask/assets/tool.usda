#usda 1.0
(
    defaultPrim = "tool"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "tool"
{

    def Xform "tube" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI", "PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        float physics:mass = 0.055000
        point3f physics:centerOfMass = (0, 0, 0.1525)
        float physxRigidBody:maxDepenetrationVelocity = 0.3
        bool physxArticulation:enabledSelfCollisions = 0
        int physxArticulation:solverPositionIterationCount = 32
        int physxArticulation:solverVelocityIterationCount = 4

        def Material "PhysicsMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:staticFriction = 0.5000
            float physics:dynamicFriction = 0.4000
            float physics:restitution = 0
        }

        def Capsule "c_tube" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </tool/tube/PhysicsMaterial>
            uniform token purpose = "guide"
            uniform token axis = "Z"
            double radius = 0.007950
            double height = 0.289100
            float physxCollision:contactOffset = 0.001
            float physxCollision:restOffset = 0
            double3 xformOp:translate = (0.000000, 0.000000, 0.152500)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Scope "Looks"
        {
            def Material "pe"
            {
                token outputs:surface.connect = </tool/tube/Looks/pe/surface.outputs:surface>
                def Shader "surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    float inputs:metallic = 0.0
                    color3f inputs:diffuseColor = (0.92, 0.92, 0.88)
                    float inputs:roughness = 0.5
                    float inputs:opacity = 0.92
                    token outputs:surface
                }
            }
        }

        def Xform "visual"
