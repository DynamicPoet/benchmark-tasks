        float3 xformOp:scale = (0.160000, 0.003000, 0.028000)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "c4" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </trolley/PhysicsMaterial>
        uniform token purpose = "guide"
        double size = 1
        float physxCollision:contactOffset = 0.004
        float physxCollision:restOffset = 0
        double3 xformOp:translate = (0.000000, 0.161500, 0.014000)
        float3 xformOp:scale = (0.160000, 0.003000, 0.028000)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Scope "Looks"
    {
        def Material "d0"
        {
            token outputs:surface.connect = </trolley/Looks/d0/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor.connect = </trolley/Looks/d0/color_tex.outputs:rgb>
                float inputs:roughness = 0.6
                token outputs:surface
            }
            def Shader "uv"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "color_tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/mr_conditional.png@
                float2 inputs:st.connect = </trolley/Looks/d0/uv.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                token inputs:sourceColorSpace = "sRGB"
                float4 inputs:scale = (1.0, 1.0, 1.0, 1)
                float3 outputs:rgb
            }
        }
        def Material "pp"
        {
            token outputs:surface.connect = </trolley/Looks/pp/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.9, 0.9, 0.88)
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }
    }

