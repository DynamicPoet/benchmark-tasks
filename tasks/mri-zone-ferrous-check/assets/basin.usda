    def Scope "Looks"
    {
        def Material "steel"
        {
            token outputs:surface.connect = </basin/Looks/steel/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 1.0
                color3f inputs:diffuseColor = (0.78, 0.78, 0.8)
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }
    }

