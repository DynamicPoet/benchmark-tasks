#usda 1.0
(
    defaultPrim = "magnet"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "magnet" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    float physics:mass = 0.3000
    int physxRigidBody:solverPositionIterationCount = 32
    int physxRigidBody:solverVelocityIterationCount = 4
    float physxRigidBody:maxDepenetrationVelocity = 1

    def Material "PhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:staticFriction = 0.3000
        float physics:dynamicFriction = 0.2500
        float physics:restitution = 0
    }

    def Cube "c0" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </magnet/PhysicsMaterial>
        uniform token purpose = "guide"
        double size = 1
        float physxCollision:contactOffset = 0.004
        float physxCollision:restOffset = 0
        double3 xformOp:translate = (0.000000, 0.016700, 0.000000)
        float3 xformOp:scale = (0.038100, 0.033400, 0.025400)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "c1" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </magnet/PhysicsMaterial>
        uniform token purpose = "guide"
        double size = 1
        float physxCollision:contactOffset = 0.004
        float physxCollision:restOffset = 0
        double3 xformOp:translate = (0.000000, 0.128200, 0.000000)
        float3 xformOp:scale = (0.022000, 0.189600, 0.022000)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "c2" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </magnet/PhysicsMaterial>
        uniform token purpose = "guide"
        double size = 1
        float physxCollision:contactOffset = 0.004
        float physxCollision:restOffset = 0
        double3 xformOp:translate = (0.000000, 0.229000, 0.000000)
        float3 xformOp:scale = (0.022000, 0.012000, 0.025400)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Scope "Looks"
    {
        def Material "black"
        {
            token outputs:surface.connect = </magnet/Looks/black/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.03, 0.03, 0.03)
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }
        def Material "pole"
        {
            token outputs:surface.connect = </magnet/Looks/pole/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 1.0
                color3f inputs:diffuseColor = (0.55, 0.55, 0.57)
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }
        def Material "red"
        {
            token outputs:surface.connect = </magnet/Looks/red/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.2
                color3f inputs:diffuseColor = (0.62, 0.04, 0.04)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }
        def Material "unsafe"
        {
            token outputs:surface.connect = </magnet/Looks/unsafe/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor.connect = </magnet/Looks/unsafe/color_tex.outputs:rgb>
                float inputs:roughness = 0.6
                token outputs:surface
            }
            def Shader "uv"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "color_tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/mr_unsafe.png@
                float2 inputs:st.connect = </magnet/Looks/unsafe/uv.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                token inputs:sourceColorSpace = "sRGB"
                float4 inputs:scale = (1.0, 1.0, 1.0, 1)
                float3 outputs:rgb
            }
        }
    }

