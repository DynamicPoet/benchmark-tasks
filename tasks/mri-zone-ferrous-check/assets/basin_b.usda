    def Scope "Looks"
    {
        def Material "body"
        {
            token outputs:surface.connect = </basin_b/Looks/body/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.93, 0.93, 0.9)
                float inputs:roughness = 0.18
                token outputs:surface
            }
        }
        def Material "rim"
        {
            token outputs:surface.connect = </basin_b/Looks/rim/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.05, 0.12, 0.45)
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }
    }

